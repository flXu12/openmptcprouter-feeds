        "admin/system/openmptcprouter/status": {
                "title": "Status",
                "order": 2,
                "action": {
                        "type": "template",
                        "path": "openmptcprouter/wanstatus"
                }
        },

        "admin/system/openmptcprouter/interfaces_status": {
